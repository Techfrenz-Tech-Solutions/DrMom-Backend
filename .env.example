NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drmombackend?schema=public

FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThis123!

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOST=iframe.mediadelivery.net
BUNNY_STREAM_PULL_ZONE=

# Bunny Storage — PDF/notes files only. Separate zone and credentials from
# Bunny Stream above; do not reuse the Stream API key/pull zone here.
# Set up at https://dash.bunny.net/storage (create a Storage Zone), then a
# Pull Zone connected to it with Token Authentication enabled for signed,
# private delivery of purchased course materials.
# BUNNY_STORAGE_ACCESS_KEY is the storage zone's password ("Access Key" on
# its dashboard page). BUNNY_STORAGE_ENDPOINT is region-specific — copy the
# exact "Storage Zone Region Endpoint" shown on that same page (excluding the
# zone name segment), e.g. https://sg.storage.bunnycdn.com for Singapore.
BUNNY_STORAGE_ZONE_NAME=drmom-files
BUNNY_STORAGE_ACCESS_KEY=replace-me
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_STORAGE_PULL_ZONE_URL=https://your-pull-zone.b-cdn.net
BUNNY_STORAGE_UPLOAD_FOLDER=chapters
BUNNY_STORAGE_SIGNING_KEY=replace-me
BUNNY_STORAGE_PRIVATE_ACCESS=true

# Google Sign-In (OAuth 2.0 / OpenID Connect) — used by GET /api/auth/google
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CALLBACK_URL must be added there as an "Authorized redirect URI" exactly as-is.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

LOG_LEVEL=dev
